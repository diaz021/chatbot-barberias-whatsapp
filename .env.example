# ─── Base de datos ───────────────────────────────────────────────────
# Local (con `docker compose up -d`):
DATABASE_URL=postgresql://postgres:CAMBIAME@localhost:54329/barberias
# En producción: la cadena de conexión de Supabase (Session pooler).

# ─── WhatsApp Cloud API (Meta) ───────────────────────────────────────
# Sin API_TOKEN el bot corre en MODO SIMULADO: no envía nada a Meta y
# guarda lo que habría enviado. Así se prueba todo sin credenciales.
API_TOKEN=
API_VERSION=v21.0
WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
META_APP_ID=

# Nombres de las plantillas aprobadas en Meta (avisos y recordatorios).
PLANTILLA_TURNO_NUEVO=turno_nuevo
PLANTILLA_RECORDATORIO=recordatorio
PLANTILLA_CANCELACION=turno_cancelado
PLANTILLA_IDIOMA=es_CO

# ─── Panel web ───────────────────────────────────────────────────────
SESION_SECRETO=cambiar-por-una-cadena-larga-al-azar
URL_PUBLICA=http://localhost:3000
PORT=3000

# ─── Tareas de fondo (recordatorios y vigilancia) ────────────────────
# Las corre UN solo proceso: el despliegue. En tu máquina, apágalas:
# el barrido de recordatorios marca turnos como enviados.
TAREAS_DE_FONDO=0
